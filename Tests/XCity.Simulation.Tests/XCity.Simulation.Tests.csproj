<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compiles the Unity-free simulation sources directly so they can be tested without a Unity licence. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/Scripts/CitySave.cs" Link="Simulation/CitySave.cs" />
    <Compile Include="../../Assets/Scripts/CitySimulation.cs" Link="Simulation/CitySimulation.cs" />
    <Compile Include="../../Assets/Scripts/CitySimulation.Garbage.cs" Link="Simulation/CitySimulation.Garbage.cs" />
    <Compile Include="../../Assets/Scripts/CitySimulation.LandValue.cs" Link="Simulation/CitySimulation.LandValue.cs" />
    <Compile Include="../../Assets/Scripts/CitySimulation.RiverPollution.cs" Link="Simulation/CitySimulation.RiverPollution.cs" />
    <Compile Include="../../Assets/Scripts/UiText.cs" Link="Simulation/UiText.cs" />
    <Compile Include="../../Assets/Scripts/CitySimulation.Economy.cs" Link="Simulation/CitySimulation.Economy.cs" />
    <Compile Include="../../Assets/Scripts/CitySimulation.Budget.cs" Link="Simulation/CitySimulation.Budget.cs" />
    <Compile Include="../../Assets/Scripts/CitySimulation.Waterfront.cs" Link="Simulation/CitySimulation.Waterfront.cs" />
    <Compile Include="../../Assets/Scripts/RoadGraph.cs" Link="Simulation/RoadGraph.cs" />
    <Compile Include="../../Assets/Scripts/WorldTerrain.cs" Link="Simulation/WorldTerrain.cs" />
    <Compile Include="../../Assets/Scripts/MapGenerator.cs" Link="Simulation/MapGenerator.cs" />
    <Compile Include="../../Assets/Scripts/MapGenerator.Water.cs" Link="Simulation/MapGenerator.Water.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
</Project>
